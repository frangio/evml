fn main() -> u256 {
  gcd(270, 192)
}

fn gcd(a, b) -> u256 {
  if @eq(a, 0) {
    b
  } else {
    if @eq(b, 0) {
      a
    } else {
      let a_even = @eq(@and(a, 1), 0);
      let b_even = @eq(@and(b, 1), 0);

      if a_even {
        if b_even {
          @shl(1, gcd(@shr(1, a), @shr(1, b)))
        } else {
          gcd(@shr(1, a), b)
        }
      } else {
        if b_even {
          gcd(a, @shr(1, b))
        } else {
          if @gt(a, b) {
            gcd(@shr(1, @sub(a, b)), b)
          } else {
            gcd(@shr(1, @sub(b, a)), a)
          }
        }
      }
    }
  }
}
