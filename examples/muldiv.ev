fn main() -> u256 {
  muldiv(
    340282366920938463463374607431768211579,
    340282366920938463463374607431768211501,
    5
  )
}

fn muldiv(x, y, denominator) -> u256 {
  let max = @not(0);
  let mm = @mulmod(x, y, max);
  let low = @mul(x, y);
  let mm_lt_low = @lt(mm, low);
  let mm_minus_low = @sub(mm, low);
  let high = @sub(mm_minus_low, mm_lt_low);

  if @eq(high, 0) {
    @div(low, denominator)
  } else {
    if @gt(denominator, high) {
      let remainder = @mulmod(x, y, denominator);
      let high_exact = @sub(high, @gt(remainder, low));
      let low_exact = @sub(low, remainder);

      let twos = @and(denominator, @sub(0, denominator));

      let denominator_odd = @div(denominator, twos);
      let low_div_twos = @div(low_exact, twos);

      let twos_flipped = @add(@div(@sub(0, twos), twos), 1);

      let low_combined = @or(low_div_twos, @mul(high_exact, twos_flipped));

      let inverse_0 = @xor(@mul(3, denominator_odd), 2);
      let inverse_1 = @mul(inverse_0, @sub(2, @mul(denominator_odd, inverse_0)));
      let inverse_2 = @mul(inverse_1, @sub(2, @mul(denominator_odd, inverse_1)));
      let inverse_3 = @mul(inverse_2, @sub(2, @mul(denominator_odd, inverse_2)));
      let inverse_4 = @mul(inverse_3, @sub(2, @mul(denominator_odd, inverse_3)));
      let inverse_5 = @mul(inverse_4, @sub(2, @mul(denominator_odd, inverse_4)));
      let inverse_6 = @mul(inverse_5, @sub(2, @mul(denominator_odd, inverse_5)));

      @mul(low_combined, inverse_6)
    } else {
      0
    }
  }
}
